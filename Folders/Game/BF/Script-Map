local RegisterAttack=Net:WaitForChild("RE/RegisterAttack")
local FastAttack={Distance=30}

function FastAttack:GetTargets()
    local target=CurrentTarget

    if not target or not target.Parent then
        return nil,nil
    end

    local Character=client.Character
    local Root=Character and Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return nil,nil
    end

    local Humanoid=target:FindFirstChildOfClass("Humanoid")

    if not Humanoid or Humanoid.Health<=0 then
        return nil,nil
    end

    local HitPart=target:FindFirstChild("HumanoidRootPart")
        or target:FindFirstChild("UpperTorso")
        or target:FindFirstChild("Torso")

    if not HitPart then
        return nil,nil
    end

    if (Root.Position-HitPart.Position).Magnitude>self.Distance then
        return nil,nil
    end

    return HitPart,{}
end

function FastAttack:Attack()
    local FirstHit,Hits=self:GetTargets()

    if not FirstHit then
        SetFastAttack(false)
        return
    end

    if type(Global.SendHitsToServer)=="function" then
        Global.SendHitsToServer(FirstHit,Hits)
    end

    pcall(function()
        RegisterAttack:FireServer(0.00)
    end)
end

