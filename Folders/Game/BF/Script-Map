local RegisterAttack=Net:WaitForChild("RE/RegisterAttack")

local FastAttack={Distance=70}

function FastAttack:GetTargets()
    local firstPart
    local hits={}

    local Character=client.Character
    local Root=Character
        and Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        return nil,nil
    end

    for _,enemy in ipairs(Enemies:GetChildren()) do
        local Humanoid=enemy:FindFirstChildOfClass("Humanoid")

        if Humanoid and Humanoid.Health>0 then
            local HitPart=
                enemy:FindFirstChild("HumanoidRootPart")
                or enemy:FindFirstChild("UpperTorso")
                or enemy:FindFirstChild("Torso")

            if HitPart
                and (Root.Position-HitPart.Position).Magnitude
                <=self.Distance then

                if not firstPart then
                    firstPart=HitPart
                else
                    hits[#hits+1]={enemy,HitPart}
                end
            end
        end
    end

    return firstPart,hits
end

function FastAttack:Attack()
    local FirstHit,Hits=self:GetTargets()

    if not FirstHit then return end

    if type(Global.SendHitsToServer)=="function" then
        Global.SendHitsToServer(FirstHit,Hits)
    end

    pcall(function()
        RegisterAttack:FireServer(0)
    end)
end

task.spawn(function()
    while task.wait() do
        if Fluent.Unloaded then break end

        if getgenv().FastAttack then
            pcall(function()
                FastAttack:Attack()
            end)
        end
    end
end)

