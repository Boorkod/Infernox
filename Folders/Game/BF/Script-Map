function Core.UpdateCharacter()
    local Character=plr.Character

    if not Character then
        HRP=nil
        BodyClip=nil
        return false
    end

    local Root=Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        HRP=nil
        BodyClip=nil
        return false
    end

    HRP=Root
    return true
end

function Core.SetBodyClip(state)
    if not HRP or not HRP.Parent then
        BodyClip=nil
        return
    end

    local Existing=HRP:FindFirstChild("BodyClip")

    if state then
        if Existing then
            BodyClip=Existing

            if Existing:IsA("BodyVelocity") then
                Existing.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                Existing.Velocity=Vector3.zero
            end

            return
        end

        BodyClip=Instance.new("BodyVelocity")
        BodyClip.Name="BodyClip"
        BodyClip.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
        BodyClip.Velocity=Vector3.zero
        BodyClip.P=9e4
        BodyClip.Parent=HRP
    else
        if Existing then
            Existing:Destroy()
        end

        BodyClip=nil
    end
end

function Core.GetQuest()
    local data=plr:FindFirstChild("Data")
    local level=data and data:FindFirstChild("Level")

    if not level then return nil end

    local lv=level.Value
    local best
    local bestReq=-1

    for name,list in pairs(Q) do
        if type(list)=="table" then
            for id,quest in ipairs(list) do
                if type(quest)=="table" then
                    local mob,amount=next(quest.Task or {})
                    local req=tonumber(quest.LevelReq)

                    if mob and amount and req
                        and amount>1
                        and lv>=req
                        and req>bestReq then

                        best={
                            Name=name,
                            ID=id,
                            Mob=mob,
                            Amount=amount
                        }

                        bestReq=req
                    end
                end
            end
        end
    end

    return best
end

function Core.GetQuestNPC(questName)
    if not Guide
        or not Guide.Data
        or not Guide.Data.NPCList then
        return nil
    end

    for _,npc in pairs(Guide.Data.NPCList) do
        if npc.InternalQuestName==questName then
            return npc.NPCName,npc.Position
        end
    end
end

function Core.HasQuest()
    local gui=plr:FindFirstChild("PlayerGui")
    if not gui then return false end

    local tracked=gui:FindFirstChild("TrackedQuestFrame")
    local frame=tracked and tracked:FindFirstChild("Frame")

    return frame and frame.Visible==true
end

function Core.TweenTo(position)
    if typeof(position)~="Vector3" then return end
    if not Core.UpdateCharacter() then return end

    if CurrentTween then
        pcall(function()
            CurrentTween:Cancel()
        end)
        CurrentTween=nil
    end

    local root=HRP
    local distance=(root.Position-position).Magnitude

    if distance<=2 then
        root.CFrame=CFrame.new(position)
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
        return
    end

    Core.SetBodyClip(true)

    local duration=distance/TweenSpeed

    local tween=TweenService:Create(
        root,
        TweenInfo.new(
            duration,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.InOut
        ),
        {CFrame=CFrame.new(position)}
    )

    CurrentTween=tween
    tween:Play()

    pcall(function()
        tween.Completed:Wait()
    end)

    if CurrentTween==tween then
        CurrentTween=nil
    end

    pcall(function()
        tween:Destroy()
    end)

    if root.Parent then
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
    end
end

function Core.UpdateFarmOffset()
    if FarmMode=="Behind" then
        FarmOffset=CFrame.new(0,0,FarmDistance)
    elseif FarmMode=="Below" then
        FarmOffset=CFrame.new(0,-FarmDistance,0)
            *CFrame.Angles(math.rad(90),0,0)
    elseif FarmMode=="Upper" then
        FarmOffset=CFrame.new(0,FarmDistance,0)
            *CFrame.Angles(math.rad(-90),0,0)
    else
        FarmOffset=CFrame.new()
    end

    return FarmOffset
end

function Core.ModeFarm()
    if not HRP or not HRP.Parent then return end

    Core.UpdateFarmOffset()
    Core.SetBodyClip(getgenv().AutoFarm==true)
end

function Core.GetTargetMob()
    local quest=Core.GetQuest()

    if not quest or not quest.Mob then
        return nil
    end

    for _,mob in ipairs(Enemies:GetChildren()) do
        if mob.Name==quest.Mob then
            local Humanoid=mob:FindFirstChildOfClass("Humanoid")
            local Head=mob:FindFirstChild("Head")

            if Humanoid and Head
                and Humanoid.Health>0
                and Humanoid:GetState()
                ~=Enum.HumanoidStateType.Dead then
                return mob
            end
        end
    end

    return nil
end

function Core.GetMobSpawns(mobName)
    local result={}

    for _,spawn in ipairs(EnemySpawns:GetChildren()) do
        if spawn:IsA("BasePart")
            and spawn.Name:sub(1,#mobName)==mobName then
            result[#result+1]=spawn
        end
    end

    return result
end

function Core.ScanMobSpawn(quest)
    if not quest or not quest.Mob then
        return nil
    end

    if SpawnMob~=quest.Mob then
        SpawnMob=quest.Mob
        SpawnIndex=1
        SpawnPoints=Core.GetMobSpawns(quest.Mob)
    end

    local target=Core.GetTargetMob()

    if target then
        return target
    end

    if #SpawnPoints==0 then
        return nil
    end

    local spawn=SpawnPoints[SpawnIndex]
    SpawnIndex=SpawnIndex%#SpawnPoints+1

    if spawn and spawn.Parent then
        Core.TweenTo(spawn.Position)

        local timeout=os.clock()+2

        while os.clock()<timeout do
            target=Core.GetTargetMob()

            if target then
                return target
            end

            task.wait(0.1)
        end
    end

    return Core.GetTargetMob()
end

function Core.FarmMob()
    if not Core.UpdateCharacter() then return end

    local quest=Core.GetQuest()

    if not quest then
        CurrentTarget=nil
        return
    end

    local target=Core.GetTargetMob()

    if not target then
        target=Core.ScanMobSpawn(quest)
    end

    if not target then
        CurrentTarget=nil
        return
    end

    local Head=target:FindFirstChild("Head")

    if not Head then
        CurrentTarget=nil
        return
    end

    local TargetCFrame=Head.CFrame*FarmOffset

    if CurrentTarget~=target then
        CurrentTarget=target
        Core.TweenTo(TargetCFrame.Position)
    end

    if HRP and HRP.Parent and Head.Parent then
        HRP.CFrame=Head.CFrame*FarmOffset
        HRP.AssemblyLinearVelocity=Vector3.zero
        HRP.AssemblyAngularVelocity=Vector3.zero
    end
end

function Core.IsValidBringMob(mob,name)
    if not mob or not mob.Parent or mob.Name~=name then
        return false
    end

    local Humanoid=mob:FindFirstChildOfClass("Humanoid")
    local Root=mob:FindFirstChild("HumanoidRootPart")

    return Humanoid and Root
        and Humanoid.Health>0
        and Humanoid:GetState()
        ~=Enum.HumanoidStateType.Dead
end

function Core.Cleanup()
    getgenv().AutoFarm=false
    getgenv().Noclip=false
    getgenv().bringmob=false
    getgenv().FastAttack=false

    if CurrentTween then
        pcall(function()
            CurrentTween:Cancel()
        end)
        CurrentTween=nil
    end

    if HRP and HRP.Parent then
        Core.SetBodyClip(false)
    end

    CurrentTarget=nil
    BringPosition=nil
    BringTarget=nil
    BringQuestMob=nil
    BodyClip=nil
end

