local function EquipTool(Type)
    local char=plr.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    local backpack=plr:FindFirstChild("Backpack")
    if not hum or not backpack then return false end

    for _,tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:GetAttribute("WeaponType")==Type then
            return true
        end
    end

    for _,tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool:GetAttribute("WeaponType")==Type then
            pcall(function()
                hum:EquipTool(tool)
            end)

            task.wait(.15)

            local event=tool:FindFirstChild("EquipEvent")
            if event then
                pcall(function()
                    event:FireServer(true)
                end)
            end

            return true
        end
    end

    return false
end

function Core.UpdateCharacter()
    local Character=plr.Character

    if not Character then
        HRP=nil
        BodyClip=nil
        return false
    end

    local Root=Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        HRP=nil
        BodyClip=nil
        return false
    end

    HRP=Root
    return true
end

function Core.SetBodyClip(state)
    if not HRP or not HRP.Parent then
        BodyClip=nil
        return
    end

    local Existing=HRP:FindFirstChild("BodyClip")

    if state then
        if Existing then
            BodyClip=Existing

            if Existing:IsA("BodyVelocity") then
                Existing.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                Existing.Velocity=Vector3.zero
            end

            return
        end

        BodyClip=Instance.new("BodyVelocity")
        BodyClip.Name="BodyClip"
        BodyClip.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
        BodyClip.Velocity=Vector3.zero
        BodyClip.P=9e4
        BodyClip.Parent=HRP
    elseif Existing then
        Existing:Destroy()
        BodyClip=nil
    else
        BodyClip=nil
    end
end

function Core.GetQuest()
    local data=plr:FindFirstChild("Data")
    local level=data and data:FindFirstChild("Level")

    if not level then
        return
    end

    local lv=level.Value
    local best,bestReq=nil,-1

    for name,list in pairs(Q) do
        if type(list)=="table" then
            for id,quest in ipairs(list) do
                if type(quest)=="table" then
                    local mob,amount=next(quest.Task or {})
                    local req=tonumber(quest.LevelReq)

                    if mob and amount and req and amount>1 and lv>=req and req>bestReq then
                        best={
                            Name=name,
                            ID=id,
                            Mob=mob,
                            Amount=amount
                        }

                        bestReq=req
                    end
                end
            end
        end
    end

    return best
end

function Core.GetQuestNPC(questName)
    if not Guide or not Guide.Data or not Guide.Data.NPCList then
        return
    end

    for _,npc in pairs(Guide.Data.NPCList) do
        if npc.InternalQuestName==questName then
            local pos=npc.Position

            if typeof(pos)=="CFrame" then
                pos=pos.Position
            end

            return npc.NPCName,pos
        end
    end
end

local function NormalizeText(text)
    text=tostring(text or ""):lower():gsub("[%p]"," "):gsub("%s+"," ")
    return text:match("^%s*(.-)%s*$") or ""
end

local function NormalizeMobName(name)
    name=NormalizeText(name)

    if #name>2 and name:sub(-1)=="s" then
        name=name:sub(1,-2)
    end

    return name
end

local function SplitWords(text)
    local result={}

    for word in tostring(text or ""):gmatch("%S+") do
        result[#result+1]=word
    end

    return result
end

local function MobMatchesText(mob,text)
    mob=NormalizeMobName(mob)
    text=NormalizeText(text)

    if mob=="" or text=="" then
        return false,0
    end

    if text:find(mob,1,true) or text:find(mob.."s",1,true) then
        return true,100
    end

    local mobWords=SplitWords(mob)

    if #mobWords==0 then
        return false,0
    end

    local matched=0

    for _,word in ipairs(mobWords) do
        if #word>=2 and text:find(word,1,true) then
            matched+=1
        end
    end

    local score=(matched/#mobWords)*100

    return score>=50,score
end

local function FindMobFromText(text)
    text=NormalizeText(text)

    if text=="" then
        return nil,0
    end

    local bestMob,bestScore=nil,0

    for _,list in pairs(Q) do
        if type(list)=="table" then
            for _,quest in ipairs(list) do
                if type(quest)=="table" then
                    local mob=next(quest.Task or {})

                    if mob then
                        local matched,score=MobMatchesText(mob,text)

                        if matched and score>bestScore then
                            bestMob,bestScore=mob,score
                        end
                    end
                end
            end
        end
    end

    return bestMob,bestScore
end

function Core.IsQuestActive()
    local tracked=PlayerGui:FindFirstChild("TrackedQuestFrame")
    local frame=tracked and tracked:FindFirstChild("Frame")

    if not frame then
        return false
    end

    if frame:IsA("GuiObject") and not frame.Visible then
        return false
    end

    return true
end

function Core.GetCurrentQuestMob()
    local tracked=PlayerGui:FindFirstChild("TrackedQuestFrame")
    local frame=tracked and tracked:FindFirstChild("Frame")

    if not frame or frame:IsA("GuiObject") and not frame.Visible then
        return
    end

    local header=frame:FindFirstChild("header")
    local headerLabel=header and header:FindFirstChild("textLabel")
    local description=frame:FindFirstChild("description")
    local bestMob,bestScore=nil,0

    if headerLabel and headerLabel:IsA("TextLabel") then
        local mob,score=FindMobFromText(headerLabel.Text)

        if mob and score>bestScore then
            bestMob,bestScore=mob,score
        end
    end

    if description and description:IsA("TextLabel") then
        local mob,score=FindMobFromText(description.Text)

        if mob and score>bestScore then
            bestMob,bestScore=mob,score
        end
    end

    return bestMob
end

function Core.HasQuest()
    return Core.IsQuestActive()
end

function Core.TweenTo(position,extraHeight)
    if typeof(position)~="Vector3" or not Core.UpdateCharacter() then
        return false
    end

    if extraHeight then
        position=position+Vector3.new(0,extraHeight,0)
    end

    SetFastAttack(false)

    if CurrentTween then
        pcall(function()
            CurrentTween:Cancel()
        end)

        CurrentTween=nil
    end

    local root=HRP
    local distance=(root.Position-position).Magnitude

    if distance<=3 then
        root.CFrame=CFrame.new(position)
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
        return true
    end

    Core.SetBodyClip(true)

    local tweenTime=math.max(distance/TweenSpeed,.1)

    local tween=TweenService:Create(
        root,
        TweenInfo.new(
            tweenTime,
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.InOut
        ),
        {
            CFrame=CFrame.new(position)
        }
    )

    CurrentTween=tween
    tween:Play()

    local completed=false

    local connection=tween.Completed:Connect(function()
        completed=true
    end)

    while not completed do
        if not getgenv().AutoFarm and not UnderwaterMoving then
            pcall(function()
                tween:Cancel()
            end)

            break
        end

        if not root.Parent then
            break
        end

        task.wait()
    end

    pcall(function()
        connection:Disconnect()
    end)

    if CurrentTween==tween then
        CurrentTween=nil
    end

    pcall(function()
        tween:Destroy()
    end)

    if root.Parent then
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
    end

    if not root.Parent then
        return false
    end

    local remain=(root.Position-position).Magnitude

    if remain>8 then
        local timeout=os.clock()+3

        while os.clock()<timeout and root.Parent do
            local currentDistance=(root.Position-position).Magnitude

            if currentDistance<=5 then
                break
            end

            task.wait(.05)
        end
    end

    return root.Parent and (root.Position-position).Magnitude<=8
end

