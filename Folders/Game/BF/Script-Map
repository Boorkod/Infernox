function Core.CheckUnderwater()
    local data=plr:FindFirstChild("Data")
    local level=data and data:FindFirstChild("Level")

    if not level or not Core.UpdateCharacter() then
        return false
    end

    local lv=level.Value
    local Map=workspace:FindFirstChild("Map")
    local TeleportSpawn=Map and Map:FindFirstChild("TeleportSpawn")

    if not TeleportSpawn then
        return false
    end

    local Entrance=TeleportSpawn:FindFirstChild("Entrance")
    local Exit=TeleportSpawn:FindFirstChild("Exit")

    if lv>=375 and lv<450 then
        if UnderwaterState~="Entered" and Entrance and not UnderwaterMoving then
            UnderwaterMoving=true

            SetFastAttack(false)
            CurrentTarget=nil
            Core.ClearBring()

            local destination=Entrance.Position+Vector3.new(0,2,0)
            local success=Core.TweenTo(destination)

            if success and HRP and HRP.Parent then
                local distance=(HRP.Position-destination).Magnitude

                if distance<=8 then
                    UnderwaterState="Entered"
                end
            end

            task.wait(3)

            UnderwaterMoving=false

            return true
        end

        return UnderwaterMoving

    elseif lv==450 then
        if UnderwaterState~="Exited" and Exit and not UnderwaterMoving then
            UnderwaterMoving=true

            SetFastAttack(false)
            CurrentTarget=nil
            Core.ClearBring()

            local destination=Exit.Position+Vector3.new(0,2,0)
            local success=Core.TweenTo(destination)

            if success and HRP and HRP.Parent then
                local distance=(HRP.Position-destination).Magnitude

                if distance<=8 then
                    UnderwaterState="Exited"
                end
            end

            task.wait(3)

            UnderwaterMoving=false

            return true
        end

        return UnderwaterMoving
    end

    UnderwaterState="None"
    UnderwaterMoving=false

    return false
end

