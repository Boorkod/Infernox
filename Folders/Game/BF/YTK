local function EquipTool(Type)
    local char=plr.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    local backpack=plr:FindFirstChild("Backpack")

    if not hum or not backpack then return false end

    for _,tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") and tool:GetAttribute("WeaponType")==Type then
            return true
        end
    end

    for _,tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") and tool:GetAttribute("WeaponType")==Type then
            pcall(function()
                hum:EquipTool(tool)
            end)

            task.wait(.15)

            local event=tool:FindFirstChild("EquipEvent")
            if event then
                pcall(function()
                    event:FireServer(true)
                end)
            end

            return true
        end
    end

    return false
end

function Core.UpdateCharacter()
    local Character=plr.Character

    if not Character then
        HRP=nil
        BodyClip=nil
        return false
    end

    local Root=Character:FindFirstChild("HumanoidRootPart")

    if not Root then
        HRP=nil
        BodyClip=nil
        return false
    end

    HRP=Root
    return true
end

function Core.SetBodyClip(state)
    if not HRP or not HRP.Parent then
        BodyClip=nil
        return
    end

    local Existing=HRP:FindFirstChild("BodyClip")

    if state then
        if Existing then
            BodyClip=Existing

            if Existing:IsA("BodyVelocity") then
                Existing.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
                Existing.Velocity=Vector3.zero
            end

            return
        end

        BodyClip=Instance.new("BodyVelocity")
        BodyClip.Name="BodyClip"
        BodyClip.MaxForce=Vector3.new(math.huge,math.huge,math.huge)
        BodyClip.Velocity=Vector3.zero
        BodyClip.P=9e4
        BodyClip.Parent=HRP
    elseif Existing then
        Existing:Destroy()
        BodyClip=nil
    else
        BodyClip=nil
    end
end

function Core.GetQuest()
    local data=plr:FindFirstChild("Data")
    local level=data and data:FindFirstChild("Level")

    if not level then return end

    local lv=level.Value
    local best,bestReq=nil,-1

    for name,list in pairs(Q) do
        if type(list)=="table" then
            for id,quest in ipairs(list) do
                if type(quest)=="table" then
                    local mob,amount=next(quest.Task or {})
                    local req=tonumber(quest.LevelReq)

                    if mob and amount and req and amount>1 and lv>=req and req>bestReq then
                        best={
                            Name=name,
                            ID=id,
                            Mob=mob,
                            Amount=amount
                        }
                        bestReq=req
                    end
                end
            end
        end
    end

    return best
end

function Core.GetQuestNPC(questName)
    if not Guide or not Guide.Data or not Guide.Data.NPCList then
        return
    end

    if not HRP or not HRP.Parent then
        Core.UpdateCharacter()
    end

    if not HRP then return end

    local nearestName,nearestPosition
    local nearestDistance=math.huge

    for _,npc in pairs(Guide.Data.NPCList) do
        if npc.InternalQuestName==questName then
            local pos=npc.Position

            if typeof(pos)=="CFrame" then
                pos=pos.Position
            end

            if typeof(pos)=="Vector3" then
                local distance=(HRP.Position-pos).Magnitude

                if distance<nearestDistance then
                    nearestDistance=distance
                    nearestName=npc.NPCName
                    nearestPosition=pos
                end
            end
        end
    end

    return nearestName,nearestPosition
end

local function NormalizeText(text)
    return tostring(text or ""):lower():gsub("[%p]"," "):gsub("%s+"," "):match("^%s*(.-)%s*$") or ""
end

local function NormalizeMobName(name)
    name=NormalizeText(name)

    if #name>2 and name:sub(-1)=="s" then
        name=name:sub(1,-2)
    end

    return name
end

local function SplitWords(text)
    local result={}

    for word in tostring(text or ""):gmatch("%S+") do
        result[#result+1]=word
    end

    return result
end

local function MobMatchesText(mob,text)
    mob=NormalizeMobName(mob)
    text=NormalizeText(text)

    if mob=="" or text=="" then
        return false,0
    end

    local mobWords=SplitWords(mob)
    local textWords=SplitWords(text)

    if #mobWords==0 or #textWords==0 then
        return false,0
    end

    local matched=0

    for _,mobWord in ipairs(mobWords) do
        for _,textWord in ipairs(textWords) do
            if #textWord>=2 and
                (textWord==mobWord or mobWord:sub(1,#textWord)==textWord) then
                matched+=1
                break
            end
        end
    end

    local score=(matched/#mobWords)*100
    return score>=50,score
end

local function FindMobFromText(text)
    text=NormalizeText(text)

    if text=="" then return nil,0 end

    local bestMob,bestScore=nil,0

    for _,list in pairs(Q) do
        if type(list)=="table" then
            for _,quest in ipairs(list) do
                if type(quest)=="table" then
                    local mob=next(quest.Task or {})

                    if mob then
                        local matched,score=MobMatchesText(mob,text)

                        if matched and score>bestScore then
                            bestMob,bestScore=mob,score
                        end
                    end
                end
            end
        end
    end

    return bestMob,bestScore
end

function Core.IsQuestActive()
    local tracked=PlayerGui:FindFirstChild("TrackedQuestFrame")
    local frame=tracked and tracked:FindFirstChild("Frame")

    return frame
        and (not frame:IsA("GuiObject") or frame.Visible)
        or false
end

function Core.GetCurrentQuestMob()
    local tracked=PlayerGui:FindFirstChild("TrackedQuestFrame")
    local frame=tracked and tracked:FindFirstChild("Frame")

    if not frame or frame:IsA("GuiObject") and not frame.Visible then
        return
    end

    local header=frame:FindFirstChild("header")
    local headerLabel=header and header:FindFirstChild("textLabel")
    local description=frame:FindFirstChild("description")
    local bestMob,bestScore=nil,0

    for _,obj in ipairs({headerLabel,description}) do
        if obj and obj:IsA("TextLabel") then
            local mob,score=FindMobFromText(obj.Text)

            if mob and score>bestScore then
                bestMob,bestScore=mob,score
            end
        end
    end

    return bestMob
end

