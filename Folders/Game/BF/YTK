function Core.TweenTo(position,extraHeight)
    if typeof(position)~="Vector3" or not Core.UpdateCharacter() then
        return false
    end

    local RealPosition=position

    if extraHeight then
        position+=Vector3.new(0,extraHeight,0)
    end

    SetFastAttack(false)

    if CurrentTween then
        pcall(function()
            CurrentTween:Cancel()
        end)
        CurrentTween=nil
    end

    local root=HRP
    local distance=(root.Position-position).Magnitude

    if distance<=3 then
        root.CFrame=CFrame.new(RealPosition)
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
        Core.SetBodyClip(false)
        return true
    end

    Core.SetBodyClip(true)

    local tween=TweenService:Create(
        root,
        TweenInfo.new(
            math.max(distance/TweenSpeed,.1),
            Enum.EasingStyle.Linear,
            Enum.EasingDirection.InOut
        ),
        {CFrame=CFrame.new(position)}
    )

    CurrentTween=tween
    TweenManual=true
    tween:Play()

    local completed=false
    local connection=tween.Completed:Connect(function()
        completed=true
    end)

    while not completed and TweenManual and root.Parent and Alive() do
        task.wait()
    end

    pcall(function()
        connection:Disconnect()
    end)

    if CurrentTween==tween then
        CurrentTween=nil
    end

    pcall(function()
        tween:Destroy()
    end)

    TweenManual=false

    if not root.Parent then
        Core.SetBodyClip(false)
        return false
    end

    root.AssemblyLinearVelocity=Vector3.zero
    root.AssemblyAngularVelocity=Vector3.zero

    local remain=(root.Position-RealPosition).Magnitude

    if remain>.5 then
        local FinalTween=TweenService:Create(
            root,
            TweenInfo.new(math.clamp(remain/100,.08,.2),Enum.EasingStyle.Linear),
            {CFrame=CFrame.new(RealPosition)}
        )

        CurrentTween=FinalTween

        local done=false
        local finalConnection=FinalTween.Completed:Connect(function()
            done=true
        end)

        FinalTween:Play()

        while not done and root.Parent and Alive() do
            task.wait()
        end

        pcall(function()
            finalConnection:Disconnect()
        end)

        if CurrentTween==FinalTween then
            CurrentTween=nil
        end

        pcall(function()
            FinalTween:Destroy()
        end)
    end

    if root.Parent then
        root.CFrame=CFrame.new(RealPosition)
        root.AssemblyLinearVelocity=Vector3.zero
        root.AssemblyAngularVelocity=Vector3.zero
    end

    Core.SetBodyClip(false)

    return root.Parent and (root.Position-RealPosition).Magnitude<=8
end

function Core.TweenToTravel(position)
    return Core.TweenTo(position,TweenHeight)
end

function Core.CancelTween()
    TweenManual=false

    if CurrentTween then
        pcall(function()
            CurrentTween:Cancel()
        end)
        CurrentTween=nil
    end

    Core.SetBodyClip(false)
end

function Core.UpdateFarmOffset()
    local height=tonumber(FarmHeight) or 5

    if FarmMode=="Behind" then
        FarmOffset=CFrame.new(0,0,FarmDistance)
    elseif FarmMode=="Below" then
        FarmOffset=CFrame.new(0,-height,0)*CFrame.Angles(math.rad(90),0,0)
    elseif FarmMode=="Upper" then
        FarmOffset=CFrame.new(0,height*4,0)*CFrame.Angles(0,math.rad(90),0)
    else
        FarmOffset=CFrame.new()
    end

    return FarmOffset
end

function Core.ModeFarm()
    if HRP and HRP.Parent then
        Core.UpdateFarmOffset()

        if getgenv().AutoFarm then
            Core.SetBodyClip(true)
        end
    end
end

function Core.GetTargetMob()
    local quest=ActiveQuest or Core.GetQuest()

    if not quest or not quest.Mob then return end

    local target,lowestHealth=nil,math.huge

    for _,mob in ipairs(Enemies:GetChildren()) do
        if mob.Name==quest.Mob then
            local Humanoid=mob:FindFirstChildOfClass("Humanoid")
            local Head=mob:FindFirstChild("Head")

            if Humanoid and Head and
                Humanoid.Health>0 and
                Humanoid:GetState()~=Enum.HumanoidStateType.Dead and
                Humanoid.Health<lowestHealth then

                target,lowestHealth=mob,Humanoid.Health
            end
        end
    end

    return target
end

function Core.GetMobSpawns(mobName)
    local result={}

    for _,spawn in ipairs(EnemySpawns:GetChildren()) do
        if spawn:IsA("BasePart") and spawn.Name:sub(1,#mobName)==mobName then
            result[#result+1]=spawn
        end
    end

    return result
end

function Core.ScanMobSpawn(quest)
    if not quest or not quest.Mob then return end

    if SpawnMob~=quest.Mob then
        SpawnMob=quest.Mob
        SpawnIndex=1
        SpawnPoints=Core.GetMobSpawns(quest.Mob)
    end

    local target=Core.GetTargetMob()
    if target then return target end
    if #SpawnPoints==0 then return end

    for _=1,#SpawnPoints do
        target=Core.GetTargetMob()
        if target then return target end

        local spawn=SpawnPoints[SpawnIndex]
        SpawnIndex=SpawnIndex%#SpawnPoints+1

        if spawn and spawn.Parent then
            SetFastAttack(false)
            Core.TweenToTravel(spawn.Position)

            local timeout=os.clock()+2

            while os.clock()<timeout and Alive() do
                target=Core.GetTargetMob()

                if target then
                    return target
                end

                task.wait(.1)
            end
        end
    end

    return Core.GetTargetMob()
end

function Core.FarmMob()
    if not Core.UpdateCharacter() then
        SetFastAttack(false)
        return
    end

    local quest=ActiveQuest or Core.GetQuest()

    if not quest then
        CurrentTarget=nil
        SetFastAttack(false)
        return
    end

    local target=Core.GetTargetMob()

    if not target then
        SetFastAttack(false)
        target=Core.ScanMobSpawn(quest)
    end

    if not target then
        CurrentTarget=nil
        SetFastAttack(false)
        return
    end

    local Head=target:FindFirstChild("Head")
    local Humanoid=target:FindFirstChildOfClass("Humanoid")

    if not Head or not Humanoid or Humanoid.Health<=0 then
        CurrentTarget=nil
        SetFastAttack(false)
        return
    end

    if CurrentTarget~=target then
        EquipTool(SelectedWeaponType)
        SetFastAttack(false)
        CurrentTarget=target

        Core.UpdateFarmOffset()
        Core.TweenTo((Head.CFrame*FarmOffset).Position)

        if CurrentTarget==target and
            target.Parent and
            Humanoid.Health>0 then

            Core.SetBodyClip(true)
            SetFastAttack(true)
        end
    else
        SetFastAttack(true)
    end

    if CurrentTarget==target and
        HRP and HRP.Parent and
        Head.Parent and
        Humanoid.Health>0 then

        HRP.CFrame=Head.CFrame*FarmOffset
        HRP.AssemblyLinearVelocity=Vector3.zero
        HRP.AssemblyAngularVelocity=Vector3.zero
    else
        SetFastAttack(false)
    end
end

function Core.IsValidBringMob(mob,name)
    if not mob or not mob.Parent or mob.Name~=name then
        return false
    end

    local Humanoid=mob:FindFirstChildOfClass("Humanoid")
    local Root=mob:FindFirstChild("HumanoidRootPart")

    return Humanoid and Root and
        Humanoid.Health>0 and
        Humanoid:GetState()~=Enum.HumanoidStateType.Dead
end

