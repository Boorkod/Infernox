local function HideNotificationObjects(Notifications)
    if not Notifications then return end

    for _,obj in ipairs(Notifications:GetDescendants()) do
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            obj.Visible=not HideNotification
        elseif obj:IsA("GuiObject") and obj.Name=="NotificationStack" then
            obj.Visible=not HideNotification
        end
    end
end

local function SetNotification(state)
    HideNotification=state==true

    local Notifications=PlayerGui:FindFirstChild("Notifications")

    if not Notifications or not Notifications:IsA("ScreenGui") then
        return
    end

    Notifications.Enabled=true
    HideNotificationObjects(Notifications)

    if NotificationConnection then
        pcall(function()
            NotificationConnection:Disconnect()
        end)
    end

    NotificationConnection=Notifications.DescendantAdded:Connect(function(obj)
        if not HideNotification then return end

        task.defer(function()
            if not obj or not obj.Parent then return end

            if obj:IsA("TextLabel") or obj:IsA("TextButton") then
                obj.Visible=false
            elseif obj:IsA("GuiObject") and obj.Name=="NotificationStack" then
                obj.Visible=false
            end
        end)
    end)

    AddConnection(NotificationConnection)
end

