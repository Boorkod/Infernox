            if position then
                Core.TweenToTravel(position)
                task.wait(.25)

                if not Core.IsQuestActive() then
                    pcall(function()
                        CommF:InvokeServer(
                            "StartQuest",
                            quest.Name,
                            quest.ID
                        )
                    end)

                    task.wait(0.5)

                    if Core.IsQuestActive() then
                        ActiveQuest=quest
                    end
                end
            end

            continue
        end

        if not ActiveQuest then
            ActiveQuest=Core.GetQuest()
        end

        if ActiveQuest then
            pcall(function()
                Core.FarmMob()
            end)
        end
    end
end)

