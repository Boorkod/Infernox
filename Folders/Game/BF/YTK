local function SaberProgress()
    local OK,Data=pcall(function()
        return CommF:InvokeServer("ProQuestProgress")
    end)

    return OK and type(Data)=="table" and Data or {}
end

local function SaberGetTool(Name)
    local Character=plr.Character
    local Backpack=plr:FindFirstChild("Backpack")

    return (Character and Character:FindFirstChild(Name))
        or (Backpack and Backpack:FindFirstChild(Name))
end

local function SaberWaitTool(Name,Timeout)
    local Start=os.clock()

    repeat
        if not Alive() or not getgenv().SaberQuest then return end

        local Tool=SaberGetTool(Name)
        if Tool then return Tool end

        task.wait(.15)
    until Timeout and os.clock()-Start>=Timeout
end

local function SaberEquipTool(Name)
    local Tool=SaberGetTool(Name)

    if not Tool then return false end

    local Character=plr.Character
    local Humanoid=Character and Character:FindFirstChildOfClass("Humanoid")

    if not Humanoid then return false end

    if Tool.Parent==plr.Backpack then
        pcall(function()
            Humanoid:EquipTool(Tool)
        end)

        task.wait(.3)
    end

    return Tool.Parent==Character
end

local function SaberTween(Position)
    if not getgenv().SaberQuest or not Position then
        return false
    end

    SaberLocked=false
    SaberLockPosition=nil
    Core.SetBodyClip(false)

    local Result=Core.TweenToTravel(Position)

    if not Result or not HRP or not HRP.Parent then
        return false
    end

    SaberLockPosition=Position
    SaberLocked=true
    Core.SetBodyClip(true)

    HRP.CFrame=CFrame.new(Position)
    HRP.AssemblyLinearVelocity=Vector3.zero
    HRP.AssemblyAngularVelocity=Vector3.zero

    task.wait(.1)

    return true
end

--// SABER LOCK
task.spawn(function()
    while Alive() and task.wait(.05) do
        if Fluent.Unloaded then break end

        if not getgenv().SaberQuest then
            SaberLocked=false
            SaberLockPosition=nil
            continue
        end

        if SaberLocked and SaberLockPosition and
            HRP and HRP.Parent then

            HRP.CFrame=CFrame.new(SaberLockPosition)
            HRP.AssemblyLinearVelocity=Vector3.zero
            HRP.AssemblyAngularVelocity=Vector3.zero
        end
    end
end)

local function SaberWaitMob(Name)
    local Start=os.clock()

    repeat
        if not Alive() or not getgenv().SaberQuest then return end

        local Mob=Enemies:FindFirstChild(Name)
        if Mob then return Mob end

        task.wait(.15)
    until os.clock()-Start>=15
end

local function SaberKillMob(Name,Position)
    SaberLocked=false
    SaberLockPosition=nil
    Core.SetBodyClip(false)
    SetFastAttack(false)
    CurrentTarget=nil

    if not Core.UpdateCharacter() then return false end

    local Mob=SaberWaitMob(Name)

    if not Mob then
        if not Position then return false end
        if not Core.TweenToTravel(Position) then return false end

        Mob=SaberWaitMob(Name)
        if not Mob then return false end
    end

    local Humanoid=Mob:FindFirstChildOfClass("Humanoid")
    local Head=Mob:FindFirstChild("Head")

    if not Humanoid or not Head then return false end
    if Humanoid.Health<=0 then return true end

    EquipTool(SelectedWeaponType)
    Core.UpdateFarmOffset()

    CurrentTarget=Mob
    SetFastAttack(false)

    if not Core.TweenTo((Head.CFrame*FarmOffset).Position) then
        CurrentTarget=nil
        SetFastAttack(false)
        Core.SetBodyClip(false)
        return false
    end

    if not getgenv().SaberQuest then
        CurrentTarget=nil
        SetFastAttack(false)
        Core.SetBodyClip(false)
        return false
    end

    Core.SetBodyClip(true)
    SetFastAttack(true)

    while Alive() and
        getgenv().SaberQuest and
        Mob.Parent and
        Humanoid.Parent and
        Humanoid.Health>0 do

        if not Core.UpdateCharacter() then
            SetFastAttack(false)
            CurrentTarget=nil
            break
        end

        Head=Mob:FindFirstChild("Head")

        if not Head then
            SetFastAttack(false)
            break
        end

        Core.UpdateFarmOffset()

        local TargetPosition=(Head.CFrame*FarmOffset).Position

        if (HRP.Position-TargetPosition).Magnitude>12 then
            SetFastAttack(false)

            if not Core.TweenTo(TargetPosition) then
                CurrentTarget=nil
                SetFastAttack(false)
                break
            end
        end

        if HRP and HRP.Parent and Head.Parent then
            HRP.CFrame=Head.CFrame*FarmOffset
            HRP.AssemblyLinearVelocity=Vector3.zero
            HRP.AssemblyAngularVelocity=Vector3.zero
        end

        CurrentTarget=Mob
        SetFastAttack(true)

        task.wait(.05)
    end

    SetFastAttack(false)
    CurrentTarget=nil
    Core.SetBodyClip(false)

    return Humanoid.Health<=0 or not Mob.Parent
end

local function SaberPlates()
    local Data=SaberProgress()

    if type(Data.Plates)~="table" then return false end

    for i=1,5 do
        if not Data.Plates[i] then
            local Plate=workspace.Map.Jungle.QuestPlates:FindFirstChild("Plate"..i)
            local Button=Plate and Plate:FindFirstChild("Button")

            if Button then
                local Position

                if Button:IsA("BasePart") then
                    Position=Button.Position
                elseif Button:IsA("Model") then
                    Position=Button:GetPivot().Position
                end

                if Position then
                    if not SaberTween(Position+Vector3.new(0,2,0)) then
                        return false
                    end

                    pcall(function()
                        CommF:InvokeServer(
                            "ProQuestProgress",
                            "Plate",
                            i
                        )
                    end)

                    task.wait(.25)
                end
            end
        end
    end

    return true
end

local function SaberTorch()
    local Data=SaberProgress()

    if Data.UsedTorch then return true end
    if not SaberTween(SaberData.TorchPos) then return false end

    pcall(function()
        CommF:InvokeServer("ProQuestProgress","GetTorch")
    end)

    local Torch=SaberWaitTool("Torch",10)

    if not Torch then return false end
    if not SaberEquipTool("Torch") then return false end
    if not SaberTween(SaberData.BurnPos) then return false end

    task.wait(.5)

    pcall(function()
        CommF:InvokeServer("ProQuestProgress","DestroyTorch")
    end)

    local Start=os.clock()

    repeat
        task.wait(.2)
        Data=SaberProgress()

        if Data.UsedTorch then
            return true
        end
    until not getgenv().SaberQuest or os.clock()-Start>=8

    return false
end

local function SaberCup()
    local Data=SaberProgress()

    if Data.UsedCup then return true end

    local Cup=SaberGetTool("Cup")

    if not Cup then
        if not SaberTween(SaberData.BurnPos) then return false end

        pcall(function()
            CommF:InvokeServer("ProQuestProgress","GetCup")
        end)

        Cup=SaberWaitTool("Cup",10)
    end

    if not Cup or not SaberEquipTool("Cup") then return false end

    Cup=SaberGetTool("Cup")

    if not Cup or Cup.Parent~=plr.Character then return false end

    local Handle=Cup:WaitForChild("Handle",5)
    if not Handle then return false end

    local Drop1=Handle:FindFirstChild("Drop1")
    local Drop2=Handle:FindFirstChild("Drop2")

    if not Drop1 and not Drop2 then return false end
    if not SaberTween(SaberData.SnowPos) then return false end

    local Map=workspace:WaitForChild("Map")
    local Ice=Map:WaitForChild("Ice",10)
    if not Ice then return false end

    local ParticleDrop=Ice:WaitForChild("ParticleDrop",10)
    if not ParticleDrop then return false end

    local Water=ParticleDrop:WaitForChild("Water",10)
    if not Water then return false end

    if not SaberTween(Water.Position+Vector3.new(0,2,0)) then
        return false
    end

    local Start=os.clock()

    repeat
        task.wait(.1)

        if Drop1 and Drop1.Parent and Drop1.Transparency~=1 then
            return true
        end

        if Drop2 and Drop2.Parent and Drop2.Transparency~=1 then
            return true
        end
    until not getgenv().SaberQuest or os.clock()-Start>=15

    return false
end

local function SaberTalkSickMan()
    if not SaberTween(SaberData.SickManPos) then return false end

    task.wait(.3)

    pcall(function()
        CommF:InvokeServer("ProQuestProgress","SickMan")
    end)

    return true
end

local function SaberRichMan()
    if not SaberTween(SaberData.RichManPos) then return false end

    task.wait(.3)

    pcall(function()
        CommF:InvokeServer("ProQuestProgress","RichSon")
    end)

    return true
end

local function SaberRelic()
    while Alive() and getgenv().SaberQuest do
        local Data=SaberProgress()

        if Data.UsedRelic then return true end

        local Relic=SaberGetTool("Relic")

        if not Relic then
            if not SaberTween(SaberData.RichManPos) then
                task.wait(1)
                continue
            end

            task.wait(.4)

            pcall(function()
                CommF:InvokeServer("ProQuestProgress","RichSon")
            end)

            Relic=SaberWaitTool("Relic",8)

            if not Relic then
                task.wait(1)
                continue
            end
        end

        if not SaberTween(SaberData.SaberPos) then
            task.wait(1)
            continue
        end

        Relic=SaberGetTool("Relic")

        if not Relic then
            continue
        end

        if not SaberEquipTool("Relic") then
            task.wait(.5)
            continue
        end

        task.wait(.4)

        pcall(function()
            CommF:InvokeServer("ProQuestProgress","PlaceRelic")
        end)

        task.wait(1)

        Data=SaberProgress()

        if Data.UsedRelic then
            return true
        end

        task.wait(1)
    end

    return false
end

local function RunSaberQuest()
    if SaberQuestRunning then return end

    SaberQuestRunning=true

    task.spawn(function()
        local Success=true

        if getgenv().SaberQuest then
            Success=SaberPlates()
        end

        if Success and getgenv().SaberQuest then
            Success=SaberTorch()
        end

        if Success and getgenv().SaberQuest then
            Success=SaberCup()
        end

        if Success and getgenv().SaberQuest then
            local Data=SaberProgress()

            if not Data.TalkedSon then
                Success=SaberTalkSickMan()
            end
        end

        if Success and getgenv().SaberQuest then
            local Data=SaberProgress()

            if not Data.TalkedSon then
                Success=SaberRichMan()
            end
        end

        if Success and getgenv().SaberQuest then
            local Data=SaberProgress()

            if not Data.KilledMob then
                Success=SaberKillMob(
                    "Mob Leader",
                    SaberData.MobLeaderPos
                )
            end
        end

        if Success and getgenv().SaberQuest then
            local Data=SaberProgress()

            if not Data.UsedRelic then
                Success=SaberRichMan()
            end
        end

        if Success and getgenv().SaberQuest then
            Success=SaberRelic()
        end

        if Success and getgenv().SaberQuest then
            local Data=SaberProgress()

            if not Data.KilledShanks then
                Success=SaberKillMob(
                    "Saber Expert",
                    SaberData.SaberPos
                )
            end
        end

        SaberLocked=false
        SaberLockPosition=nil
        SetFastAttack(false)
        CurrentTarget=nil
        Core.SetBodyClip(false)
        SaberQuestRunning=false
    end)
end

